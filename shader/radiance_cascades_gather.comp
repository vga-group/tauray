#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_debug_printf : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform readonly image2DArray upper_target;
layout(binding = 1, rgba32f) uniform image2DArray lower_target;
layout(binding = 2, rgba32f) uniform readonly image2DArray prev_lower_target;

layout(push_constant) uniform push_constant_buffer
{
    int cascade;
    int c0_angular_resolution;
    float blend_ratio;
} pc;

void main()
{
    ivec3 p = ivec3(gl_GlobalInvocationID.xyz);

    int upper_angular_resolution = pc.c0_angular_resolution << (pc.cascade+1);
    int lower_angular_resolution = pc.c0_angular_resolution << pc.cascade;

    ivec3 lower_probe_index = ivec3(p.x/lower_angular_resolution, p.y/lower_angular_resolution, p.z);
    ivec2 lower_map_texel = p.xy - lower_probe_index.xy * lower_angular_resolution;

    ivec3 upper_probe_index = ivec3(p.x/upper_angular_resolution, p.y/upper_angular_resolution, p.z/2);
    ivec2 upper_map_base_texel = lower_map_texel * 2;
    ivec3 base_q = ivec3(upper_probe_index.xy * upper_angular_resolution + upper_map_base_texel, upper_probe_index.z);

    vec4 dst = imageLoad(lower_target, p);
    vec4 src_avg = vec4(0);
    src_avg += imageLoad(upper_target, base_q+ivec3(0,0,0));
    src_avg += imageLoad(upper_target, base_q+ivec3(1,0,0));
    src_avg += imageLoad(upper_target, base_q+ivec3(0,1,0));
    src_avg += imageLoad(upper_target, base_q+ivec3(1,1,0));
    src_avg /= 4;

    dst.rgb = mix(src_avg.rgb, dst.rgb, dst.a);

    if(pc.blend_ratio > 0)
    {
        vec4 prev = imageLoad(prev_lower_target, p);
        dst = mix(dst, prev, pc.blend_ratio);
    }
    imageStore(lower_target, p, dst);
}
