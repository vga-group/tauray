#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_debug_printf : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform readonly image3D upper_target;
layout(binding = 1, rgba32f) uniform image3D lower_target;
layout(binding = 2, rgba32f) uniform readonly image3D prev_lower_target;

layout(push_constant) uniform push_constant_buffer
{
    int cascade;
    int c0_angular_resolution;
    float blend_ratio;
    int cascade_size;
    int carry_from_previous;
} pc;

void main()
{
    ivec3 p = ivec3(gl_GlobalInvocationID.xyz);

    ivec3 lower_probe_index = ivec3(p.xy%pc.cascade_size, p.z);
    ivec2 lower_map_texel = p.xy/pc.cascade_size;

    ivec3 upper_probe_index = lower_probe_index / 2;
    ivec2 upper_map_base_texel = lower_map_texel * 2;

    int base_offset = pc.cascade_size/2;
    ivec3 base_q = ivec3(upper_probe_index.xy + base_offset*upper_map_base_texel, upper_probe_index.z);

    vec4 dst = imageLoad(lower_target, p);
    if(pc.carry_from_previous != 0)
    {
        vec4 src_avg = vec4(0);
        src_avg += imageLoad(upper_target, base_q+ivec3(0,0,0));
        src_avg += imageLoad(upper_target, base_q+ivec3(base_offset,0,0));
        src_avg += imageLoad(upper_target, base_q+ivec3(0,base_offset,0));
        src_avg += imageLoad(upper_target, base_q+ivec3(base_offset,base_offset,0));
        src_avg /= 4;

        dst.rgb = mix(src_avg.rgb, dst.rgb, dst.a);
    }

    if(pc.blend_ratio < 1.0f)
    {
        vec4 prev = imageLoad(prev_lower_target, p);
        dst = mix(prev, dst, pc.blend_ratio);
    }
    imageStore(lower_target, p, dst);
}
